{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["es2024", "dom"],
    "paths": {
      "@mohou/values": ["./packages/util/values/src/index.ts"],
      "@mohou/app-view": ["./packages/app/view/src/index.ts"],
      "@mohou/app-view/css": ["./packages/app/view/src/app-card-css.ts"],
      "@mohou/contract": ["./packages/app/contract/src/index.ts"],
      "@mohou/contract/event-type": ["./packages/app/contract/src/event-type.ts"],
      "@mohou/ui": ["./packages/app/ui/src/index.ts"],
      "@mohou/ui/*": ["./packages/app/ui/src/*"],
      "@mohou/runtime-provider": ["./packages/runtime/provider/src/index.ts"],
      "@mohou/runtime-pi": ["./packages/runtime/pi/src/index.ts"],
      "@mohou/host": ["./packages/host/src/index.ts"],
      "@mohou/host/http": ["./packages/host/src/http/layout.ts"],
      "@mohou/mcp-client": ["./packages/mcp/client/src/index.ts"],
      "@mohou/panel": ["./packages/panel/src/index.ts"],
      "@mohou/shell": ["./packages/shell/src/index.ts"]
    }
  },
  "include": [
    "packages/*/*/src/**/*.ts",
    "packages/*/*/src/**/*.tsx",
    "packages/*/*/tests/**/*.ts",
    "packages/*/*/tests/**/*.tsx",
    "packages/app/ui/examples/**/*.ts",
    "packages/app/ui/examples/**/*.tsx",
    "packages/host/src/**/*.ts",
    "packages/host/tests/**/*.ts",
    "packages/panel/src/**/*.ts",
    "packages/panel/src/**/*.tsx",
    "packages/panel/tests/**/*.ts",
    "packages/panel/tests/**/*.tsx",
    "packages/shell/src/**/*.ts",
    "packages/shell/src/**/*.tsx",
    "packages/shell/tests/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts"
  ],
  "exclude": ["packages/app/templates"]
}
